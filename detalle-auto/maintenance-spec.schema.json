{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixly.pe/schemas/maintenance-spec.v1.json",
  "title": "MaintenanceSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["specId", "brand", "model", "yearFrom", "yearTo", "severeConditions", "components", "source", "extractionNotes"],
  "properties": {
    "specId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "brand": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "yearFrom": { "type": "integer", "minimum": 1990, "maximum": 2035 },
    "yearTo": { "type": "integer", "minimum": 1990, "maximum": 2035 },
    "severeConditions": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["dusty_roads", "short_trips", "taxi_or_commercial", "towing", "extended_idling", "extreme_heat", "extreme_cold", "mountain", "other"] }
    },
    "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
    "source": { "$ref": "#/$defs/source" },
    "extractionNotes": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["kind", "detail"],
        "properties": { "kind": { "enum": ["ambiguity", "unit_conversion", "missing_item", "variant_split", "table_unreadable"] }, "detail": { "type": "string", "maxLength": 200 }, "pageRef": { "type": "string" } } }
    }
  },
  "$defs": {
    "interval": {
      "type": "object", "additionalProperties": false, "required": ["km", "months"],
      "properties": {
        "km": { "type": ["integer", "null"], "minimum": 500, "maximum": 300000 },
        "months": { "type": ["integer", "null"], "minimum": 1, "maximum": 120 }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["kind", "extractedAt", "extractedBy"],
      "properties": {
        "kind": { "enum": ["owner_manual", "warranty_booklet", "dealer_published", "user_entered", "placeholder"] },
        "documentTitle": { "type": "string", "maxLength": 120 },
        "edition": { "type": "string", "maxLength": 60 },
        "market": { "type": "string", "maxLength": 10 },
        "pageRefs": { "type": "array", "items": { "type": "string", "maxLength": 20 } },
        "extractedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "extractedBy": { "enum": ["llm", "human"] },
        "reviewedBy": { "type": "string" }
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["componentId", "spanishName", "zone", "action", "normal", "severe", "criticality", "source", "lineConfidence"],
      "properties": {
        "componentId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "spanishName": { "type": "string", "maxLength": 60 },
        "zone": { "enum": ["motor", "transmision", "refrigeracion", "frenos", "llantas", "electrico", "cabina", "suspension_direccion", "combustible"] },
        "action": { "enum": ["replace", "inspect", "inspect_then_replace", "rotate", "no_schedule"] },
        "normal": { "$ref": "#/$defs/interval" },
        "severe": { "oneOf": [{ "$ref": "#/$defs/interval" }, { "type": "null" }] },
        "firstServiceKm": { "type": ["integer", "null"], "minimum": 500, "maximum": 20000 },
        "replaceCriterion": {
          "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["measure", "limit", "unit"],
            "properties": { "measure": { "type": "string", "maxLength": 40 }, "limit": { "type": "number" }, "unit": { "type": "string", "maxLength": 10 } } }]
        },
        "consumable": {
          "type": "object", "additionalProperties": false,
          "properties": { "grade": { "type": "string", "maxLength": 40 }, "capacityL": { "type": "number", "minimum": 0, "maximum": 30 }, "partNote": { "type": "string", "maxLength": 80 } }
        },
        "appliesTo": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "engines": { "type": "array", "items": { "type": "string", "maxLength": 20 } },
            "transmissions": { "type": "array", "items": { "enum": ["MT", "AT", "CVT", "DCT"] } },
            "fuels": { "type": "array", "items": { "enum": ["gasolina", "diesel", "glp", "gnv", "hibrido", "electrico"] } }
          }
        },
        "criticality": { "enum": ["safety", "engine", "comfort"] },
        "source": { "$ref": "#/$defs/source" },
        "lineConfidence": { "enum": ["high", "medium", "low"] },
        "notInManual": { "type": "boolean", "description": "true when the catalog expects this item but the manual has no line for it; then normal.km and normal.months are null and action is no_schedule" }
      }
    }
  }
}